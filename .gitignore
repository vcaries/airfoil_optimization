# Docs build
# ---------------------------------------------------------------------------
site/
docs/_build/

# ---------------------------------------------------------------------------
# Project run artifacts (simulation outputs, generated media, caches)
# Keep the repo clean of large/binary regenerable outputs.
# ---------------------------------------------------------------------------
runs/
results/
*.log
outputs/
*.gif
*.mp4
# But DO keep curated portfolio media committed under docs/assets/
!docs/assets/**/*.gif
!docs/assets/**/*.mp4

# ---------------------------------------------------------------------------
# XFOIL scratch files (generated when shelling out to the binary)
# ---------------------------------------------------------------------------
*.pol
*.cp
*.bl
:00.bl
fort.*
# But keep the test fixtures under tests/data/ tracked.
!tests/data/**/*.pol
!tests/data/**/*.cp
!tests/data/**/*.bl
*.png

